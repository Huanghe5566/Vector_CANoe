<?xml version="1.0" encoding="iso-8859-1"?>
<!--Vector Test Automation Editor 2.1.34.0-->
<!--Version: 1.0-->
<testmodule title="XCP Demo Testmodule" version="1.0" xmlns="http://www.vector-informatik.de/CANoe/TestModule/1.16">
  <testcase title="Download ECU parameters" ident="tc1">
    <initialize title="Download parameters" wait="500">
      <sysvar name="ampl" namespace="XCP::XcpSim">6</sysvar>
      <sysvar name="noise_ampl" namespace="XCP::XcpSim">0</sysvar>
      <sysvar name="offset" namespace="XCP::XcpSim">0</sysvar>
      <sysvar name="period" namespace="XCP::XcpSim">5</sysvar>
    </initialize>
    <awaitvaluematch timeout="500" title="Wait for parameter download">
      <sysvar name="ampl" namespace="XCP::XcpSim">6</sysvar>
      <sysvar name="noise_ampl" namespace="XCP::XcpSim">0</sysvar>
      <sysvar name="offset" namespace="XCP::XcpSim">0</sysvar>
      <sysvar name="period" namespace="XCP::XcpSim">5</sysvar>
    </awaitvaluematch>
  </testcase>
  <testcase title="Check ECU parameters - should fail" ident="tc2">
    <statecheck wait="500" title="Read parameters">
      <expected>
        <sysvar name="ampl" namespace="XCP::XcpSim">6</sysvar>
        <sysvar name="noise_ampl" namespace="XCP::XcpSim">0</sysvar>
        <sysvar name="offset" namespace="XCP::XcpSim">0</sysvar>
        <sysvar name="period" namespace="XCP::XcpSim">4</sysvar>
      </expected>
    </statecheck>
  </testcase>
  <testcase title="Change the amplitude and observe the channel" ident="tc3">
    <preparation>
      <initialize title="Reduce the period" wait="500">
        <sysvar name="period" namespace="XCP::XcpSim">2</sysvar>
      </initialize>
    </preparation>
    <conditions>
      <value_valid>
        <sysvar name="channel3" namespace="XCP::XcpSim">
          <range><from>-10</from><to>10</to></range>
        </sysvar>
      </value_valid>
    </conditions>
    <statechange wait="2000" title="Change amplitude">
      <in>
        <sysvar name="ampl" namespace="XCP::XcpSim">1</sysvar>
      </in>
      <expected>
        <sysvar name="ampl" namespace="XCP::XcpSim">1</sysvar>
      </expected>
    </statechange>
    <statechange wait="2000" title="Change amplitude">
      <in>
        <sysvar name="ampl" namespace="XCP::XcpSim">3</sysvar>
      </in>
      <expected>
        <sysvar name="ampl" namespace="XCP::XcpSim">3</sysvar>
      </expected>
    </statechange>
    <statechange wait="2000" title="Change amplitude">
      <in>
        <sysvar name="ampl" namespace="XCP::XcpSim">5</sysvar>
      </in>
      <expected>
        <sysvar name="ampl" namespace="XCP::XcpSim">5</sysvar>
      </expected>
    </statechange>
    <statechange wait="2000" title="Change amplitude">
      <in>
        <sysvar name="ampl" namespace="XCP::XcpSim">7</sysvar>
      </in>
      <expected>
        <sysvar name="ampl" namespace="XCP::XcpSim">7</sysvar>
      </expected>
    </statechange>
    <statechange wait="2000" title="Change amplitude">
      <in>
        <sysvar name="ampl" namespace="XCP::XcpSim">10</sysvar>
      </in>
      <expected>
        <sysvar name="ampl" namespace="XCP::XcpSim">10</sysvar>
      </expected>
    </statechange>
  </testcase>
  <testcase title="Change the amplitude and observe the channel - should fail" ident="tc4">
    <preparation>
      <initialize title="Reduce the period" wait="500">
        <sysvar name="period" namespace="XCP::XcpSim">2</sysvar>
        <sysvar name="ampl" namespace="XCP::XcpSim">1</sysvar>
      </initialize>
    </preparation>
    <conditions>
      <value_valid>
        <sysvar name="channel2" namespace="XCP::XcpSim">
          <range><from>-9</from><to>9</to></range>
        </sysvar>
      </value_valid>
    </conditions>
    <statechange wait="2000" title="Change amplitude">
      <in>
        <sysvar name="ampl" namespace="XCP::XcpSim">1</sysvar>
      </in>
      <expected>
        <sysvar name="ampl" namespace="XCP::XcpSim">1</sysvar>
      </expected>
    </statechange>
    <statechange wait="2000" title="Change amplitude">
      <in>
        <sysvar name="ampl" namespace="XCP::XcpSim">3</sysvar>
      </in>
      <expected>
        <sysvar name="ampl" namespace="XCP::XcpSim">3</sysvar>
      </expected>
    </statechange>
    <statechange wait="2000" title="Change amplitude">
      <in>
        <sysvar name="ampl" namespace="XCP::XcpSim">5</sysvar>
      </in>
      <expected>
        <sysvar name="ampl" namespace="XCP::XcpSim">5</sysvar>
      </expected>
    </statechange>
    <statechange wait="2000" title="Change amplitude">
      <in>
        <sysvar name="ampl" namespace="XCP::XcpSim">7</sysvar>
      </in>
      <expected>
        <sysvar name="ampl" namespace="XCP::XcpSim">7</sysvar>
      </expected>
    </statechange>
    <statechange wait="1000" title="Change amplitude">
      <in>
        <sysvar name="ampl" namespace="XCP::XcpSim">10</sysvar>
      </in>
      <expected>
        <sysvar name="ampl" namespace="XCP::XcpSim">10</sysvar>
      </expected>
    </statechange>
  </testcase>
  <testcase title="Reset ECU parameters" ident="tc5">
    <initialize title="Download parameters" wait="500">
      <sysvar name="ampl" namespace="XCP::XcpSim">6</sysvar>
      <sysvar name="noise_ampl" namespace="XCP::XcpSim">0</sysvar>
      <sysvar name="offset" namespace="XCP::XcpSim">0</sysvar>
      <sysvar name="period" namespace="XCP::XcpSim">5</sysvar>
    </initialize>
    <awaitvaluematch timeout="500" title="Wait for parameter download">
      <sysvar name="ampl" namespace="XCP::XcpSim">6</sysvar>
      <sysvar name="noise_ampl" namespace="XCP::XcpSim">0</sysvar>
      <sysvar name="offset" namespace="XCP::XcpSim">0</sysvar>
      <sysvar name="period" namespace="XCP::XcpSim">5</sysvar>
    </awaitvaluematch>
  </testcase>
  <capltestcase name="SwitchMeasurementGroups" title="Switch Measurement Groups" />
</testmodule>