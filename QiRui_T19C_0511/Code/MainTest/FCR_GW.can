  if (!gIhu11SuppressSysvar[IHU_SW_IDX_RCTB])
  {
    TriggerIhu11SwitchEvent(IHU_SW_IDX_RCTB, @sysvar::Vehicle_Input::EventSwitch::IHU_11_RCTBSwtSet, 0);
