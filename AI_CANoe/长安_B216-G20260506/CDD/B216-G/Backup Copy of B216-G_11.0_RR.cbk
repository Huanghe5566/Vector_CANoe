<ENUMDEF id='_00000199072D2020' oid='C5CE582C11BA47feA7AFAC5D20F59DDB' temploid='7046285A23E94b24812E6A60F14F24E9' attrcatref='_000001997D1480F0' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Bus Type</TUV>
</NAME>
