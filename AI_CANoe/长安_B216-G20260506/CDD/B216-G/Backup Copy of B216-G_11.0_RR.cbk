<ENUMDEF id='_00000199071FB3D0' oid='5C521689E4304d168447E5BD659A2486' temploid='C9DEAEC1228F46c5B044EA033D94A003' attrcatref='_000001997D147D80' restr='FaultMemoryUser_Defined_Fault_Memories' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Snapshot Record Numeration Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Configures AUTOSAR DemTypeOfFreezeFrameRecordNumeration (CDS-70902).
Calculated:
- Snapshot Records have no trigger attributes (Failed, Confirmed, Update yes/no)
- Each DTC can have a different number of Snapshot Records stored (DemMaxNumberFreezeFrameRecords =: n)
- At each DTC, the Snapshot Record Numbers must be 1..n, without gaps.</TUV>
</DESC>
<QUAL>Snapshot_Record_Numeration_Type</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Calculated</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Configured</TUV>
</ETAG>
</ENUMDEF>
<CSTRDEF id='_00000199071EDFB0' oid='E6631C34A58A4ac38F5E34CC611DD53B' temploid='114476f5e9935f57b97c3d31b899d728' attrcatref='_000001997D147D80'>
<NAME>
<TUV xml:lang='en-US'>ASR UUID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>UUID of the synchronized AUTOSAR element which corresponds to the diagnostic instance.</TUV>
</DESC>
<QUAL>ASR_UUID</QUAL>
<COMMONSTRING></COMMONSTRING>
</CSTRDEF>
