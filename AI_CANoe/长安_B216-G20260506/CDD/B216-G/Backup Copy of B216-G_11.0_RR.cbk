<UNSDEF id='_000001997CFA6E70' oid='E5E65FE617AC4d5dAF220B74A63C820F' temploid='4E50598D7EA34ad0907B94747FC31667' attrcatref='_000001997D1480F0' usage='sys' v='1792' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Request CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The request CAN identifier for physical requests. The hex value not only describes the identifier but also the priority of the message. The higher the number, the lower the priority.</TUV>
</DESC>
<QUAL>CAN.ReqCanId</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFA7060' oid='FD1985ACE03C40698C77088796605A09' temploid='8F1A928D8071442b8A555654C2A03325' attrcatref='_000001997D1480F0' usage='sys' v='1536' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Response CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The response CAN identifier for physical responses. The response for functional requests is sent via the physical path.</TUV>
</DESC>
<QUAL>CAN.ResCanId</QUAL>
</UNSDEF>
<ENUMDEF id='_0000019907213170' oid='FDBA45838F094141BB8CD3EDF41606AF' temploid='D61D6570A2364e2eB940FC451F1217B9' attrcatref='_000001997D1480F0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Functional Addressing Scheme</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Addressing Scheme used for functional requests.</TUV>
</DESC>
<QUAL>CAN.AddrSchemeFunc</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Normal</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_00000199072138F0' oid='DF23E41E0B5D4f55B1114621F8E122E2' temploid='4DA67705CCAE4edd9A4EAADA46586003' attrcatref='_000001997D1480F0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Functional CAN-ID Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>CAN-ID Type used for functional request</TUV>
</DESC>
<QUAL>CAN.CanIdTypeFunc</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>11-Bit</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>29-Bit</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001997CFA7250' oid='14712B75D94C468eA7DAB482DED5E152' temploid='DD6D93D8D676436fA860209E9F5AE639' attrcatref='_000001997D1480F0' usage='sys' v='1872' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Functional Request CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The request CAN identifier for functional requests.</TUV>
</DESC>
<QUAL>CAN.ReqCanIdFunc</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFA5730' oid='5976693AEB434165808F1DF9997EFBB9' temploid='AAA2C8DCAD0F4d5b9FECEAF3BAFA5517' attrcatref='_000001997D1480F0' usage='sys' v='1920' df='hex'>
<NAME>
<TUV xml:lang='en-US'>UUDT Response CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>UUDT Response CAN-ID used for multiple responses and/or periodic responses.</TUV>
</DESC>
<QUAL>CAN.UudtResCanId</QUAL>
</UNSDEF>
<ENUMDEF id='_0000019907213350' oid='FB87FEC7A2C9468cB78027329743BF32' temploid='55F798A69E4D496e82365EC2BB8057C2' attrcatref='_000001997D1480F0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>UUDT CAN-ID Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Received CAN Format for CAN ID without segmentation (Segment Type Bit must = 0)</TUV>
</DESC>
<QUAL>CAN.UudtCanIdType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>11-Bit</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>29-Bit</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001997CFA7440' oid='AC238150BCBA4e9f801E6084D1C65EF1' temploid='236A22BB7ED34b99B96A150778D7B52A' attrcatref='_000001997D149640' usage='sys' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Timeout for the client to wait after the successful transmission of a request message for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>CAN.P2Client</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFA5160' oid='D57796FE4ECA4d0a89FBD2CA3B7C8EC0' temploid='17F5085A5AAD46bd8BD8A50BE2A50334' attrcatref='_000001997D149640' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the reception of a request message. In UDS this is the timeout for the default session. The tester will also require the P2Server timeout, since in UDS service "DiagnosticSessionControl" returns the P2Server and P2*Server timeouts – the tester has to calculate the offset manually and has to add it to the returned P2Server and P2*Server timeouts.</TUV>
</DESC>
<QUAL>CAN.P2Server</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFA9340' oid='590DAF7D6E544ca5B374EB7542F4A63A' temploid='981A47637F6A49318C86FFC3CDC7B36E' attrcatref='_000001997D149640' usage='sys' v='2000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2*Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enhanced timeout for the client to wait after the reception of a negative response message with response code 78 hex for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>CAN.P2ExClient</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFA9530' oid='A40895840E624c858468932B9C18D6BC' temploid='9C4D6D08A311402e86A050A6D6E57408' attrcatref='_000001997D149640' usage='sys' v='1950' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2*Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the transmission of a negative response message with response code 78 hex (enhanced response timing). In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>CAN.P2ExServer</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFA9720' oid='E82552FB77CF457cACCA1EA5B441AFE8' temploid='66161D73836B4a5cB03605A5800B0C85' attrcatref='_000001997D149640' usage='sys' v='4000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between functionally addressed Tester Present request messages transmitted by the client to keep a diagnostic session other than the defaultSession active in multiple servers (functional communication) or maximum time between physically transmitted request messages to a single server (physical communication).</TUV>
</DESC>
<QUAL>CAN.S3Client</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFA9910' oid='78B0566F2FBF457995B6313A4429DE2E' temploid='8A277D4CB181480a989F32CFDAAE68AB' attrcatref='_000001997D149640' usage='sys' v='5000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for the server to keep a diagnostic session other than the defaultSession active while not receiving any diagnostic request message</TUV>
</DESC>
<QUAL>CAN.S3Server</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFA5920' oid='D982405E13B84dd082BD4CC3727DC80D' temploid='1A9C386131B14e029D02B00AE733E3A4' attrcatref='_000001997D149640' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3ClientPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time for the client to wait after the successful transmission of a physically addressed request message (indicated via N_USData.con) with no response required before it can transmit the next physically addressed request message.
Minimum value = P2Server</TUV>
</DESC>
<QUAL>CAN.P3ClientPhys</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFAAE60' oid='ED048D65DCF541ab91D2CAAB7BBC4E19' temploid='22AABA5DEC33435585551D9B4D67065A' attrcatref='_000001997D1480F0' usage='sys' v='15872' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterPresentPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the TesterPresent message for physically addressed requests used to keep a diagnostic session active.</TUV>
</DESC>
<QUAL>CAN.TesterPresentPhys</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFAAA80' oid='7EFD262DA7B645068E6CE08FA24D9C70' temploid='2573FACA63C94dcf9C065B5D01369B5D' attrcatref='_000001997D149640' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3ClientFunc</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time for the client to wait after the successful transmission of a functionally addressed request message (indicated via N_USData.con) before it can transmit the next functionally addressed request message in case no response is required or the requested data is only supported by a subset of the functionally addressed servers.
Minimum value = P2Server.</TUV>
</DESC>
<QUAL>CAN.P3ClientFunc</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFA9B00' oid='D26DC7D3DBA0411dB291CDBDF1AF4DC4' temploid='0A6B2FC1A4784590810B6D8F2395245F' attrcatref='_000001997D1480F0' usage='sys' v='16000' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterPresentFunc</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the TesterPresent message for functionally addressed requests used to keep a diagnostic session active.</TUV>
</DESC>
<QUAL>CAN.TesterPresentFunc</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFAB810' oid='6DE27D7722844bb5A2B1C05D719CE405' temploid='48C51BB08406428dB383652046E2F120' attrcatref='_000001997D149640' usage='sys' v='20' df='dec'>
<NAME>
<TUV xml:lang='en-US'>STmin</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>(Separation Time) defines the minimum time gap between consecutive frames. Values from 0x00 to 0x7F (0 – 127) are absolute milliseconds. Values from 0xF1 to 0xF9 are even 100 micro seconds. Every other value range is reserved and should not be used.</TUV>
</DESC>
<QUAL>CAN.StMin</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFAC790' oid='D6EF896A7CF94043AF5342F29C9C6EB4' temploid='5535C0ECC4F74385BEB268AF6C959410' attrcatref='_000001997D1480F0' usage='sys' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Blocksize</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The Blocksize parameter indicates, how many consecutive frames shall be sent in a transmission before a flow control frame is sent. The number 0 tells the sender, that no more flow controls should disrupt the sending of the remaining flow controls</TUV>
</DESC>
<QUAL>CAN.Blocksize</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFA9CF0' oid='FAF894CAF16B44fb8015B1FC7A1F8EDD' temploid='AE608BF1472549e0BE904D83A15582D4' attrcatref='_000001997D149640' usage='sys' v='1000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout As</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, sender side</TUV>
</DESC>
<QUAL>CAN.TimeoutAs</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFAB050' oid='E735592FE61242f480FC8175F6FC9AC0' temploid='EFCE99A5A52B47d99DCEF987DF3A7B10' attrcatref='_000001997D149640' usage='sys' v='1000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Ar</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, receiver side</TUV>
</DESC>
<QUAL>CAN.TimeoutAr</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFAA890' oid='6794D5C9E189475bAA9B0F2E05AE31D8' temploid='CAB50C54EB9545f38A85A4E58777B6AF' attrcatref='_000001997D149640' usage='sys' v='1000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Bs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next flow control</TUV>
</DESC>
<QUAL>CAN.TimeoutBs</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFABDE0' oid='56B9A03F29AF437dB0E5A8D4E1F502A5' temploid='6AA7459CF3DA4f1aA663BB7C3811CA60' attrcatref='_000001997D149640' usage='sys' v='10' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Time Br</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for next transmission of flow control</TUV>
</DESC>
<QUAL>CAN.TimeBr</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFAAC70' oid='10896720F58C44dd9B21CF207BEA0738' temploid='C5575B04EA73449e9A15AB30619E19F7' attrcatref='_000001997D149640' usage='sys' v='10' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Time Cs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until next transmission of consecutive frame</TUV>
</DESC>
<QUAL>CAN.TimeCs</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFAA0D0' oid='09666D6400A94a438B644EB4EFC2D1FE' temploid='6560F131D61C416cB5FD678C7776D5A7' attrcatref='_000001997D149640' usage='sys' v='1000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Cr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next consecutive frame</TUV>
</DESC>
<QUAL>CAN.TimeoutCr</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFA9EE0' oid='AFB2B02843FE48b297A55293B479056A' temploid='4EF79462693C4617B394D987AE6122CC' attrcatref='_000001997D1480F0' usage='sys' v='4095' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Max Length of TP Message</TUV>
</NAME>
<QUAL>CAN.MaxLengthTpMessage</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFAA2C0' oid='7A03CA49176F4b4f87A6440B1C8433AE' temploid='C255AA9A58AC4fbdA74FD391614BC428' attrcatref='_000001997D1480F0' usage='sys' v='500000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Baudrate</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Bus Speed of the used transport media. Caution, the Bus Speed has to be set identical in all ECUs connected to one subnet.</TUV>
</DESC>
<QUAL>CAN.Baudrate</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFAB430' oid='88C45E571D5841ce9DC24919A74D2D39' temploid='8114C6FE9DFE40caAFF9E1710BD5280D' attrcatref='_000001997D1480F0' usage='sys' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>CANFrameFillerByte</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Fill byte used for filling CAN frames to eight byte length.</TUV>
</DESC>
<QUAL>CAN.CANFrameFillerByte</QUAL>
</UNSDEF>
<ENUMDEF id='_0000019907214070' oid='2A64E7DFBA9A42c7A663D46BB285910E' temploid='4AF233532E5B4aa98B23A6A6E08E6EB4' attrcatref='_000001997D1480F0' usage='sys' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FillerByteHandling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enables use of fill bytes; if "true", fill bytes are used, otherwise DLC may be smaller than 8.</TUV>
</DESC>
<QUAL>CAN.FillerByteHandling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>false</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>true</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000019907212BD0' oid='86D7CD4503E747cd8BAD859D690E39B4' temploid='AA6EE81EB9AF432fB4E95F17F39A102E' attrcatref='_000001997D1499B0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>CAN Extended Addressing</TUV>
</NAME>
<QUAL>CAN_Extended_Addressing</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>not supported</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>supported</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000019907213530' oid='EA0B645F30F3478a8B9EC7A8846007EB' temploid='C2FDB96B845F412bA59309E4EC9A1B97' attrcatref='_000001997D1480F0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Bus Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of transport media</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.BusType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>CAN</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000019907212DB0' oid='E6210B7B714C4b2a8E263670806CBDC9' temploid='2461C6EEA0F647e8869BB4904C1B7A54' attrcatref='_000001997D1480F0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Transport Protocol Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of used Transport Protocol (e.g. ISO15765)</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.TransportProtocolType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>ISO15765</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000019907212F90' oid='20827FC2FFFB43f081C2FC60FB263584' temploid='7EFE99D4368C4e598CCA3E9E24ACFC7A' attrcatref='_000001997D1480F0' usage='sys' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Addressing Scheme</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Addressing Scheme used for physical requests and responses.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.AddrScheme</QUAL>
<ETAG v='1'>
<TUV xml:lang='en-US'>Extended</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000019907213710' oid='8BB5EB41AF454293B4E9EE700752E581' temploid='075FA40870FF4ff3880D332E7A4988AC' attrcatref='_000001997D1480F0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>CAN-ID Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>CAN-ID Type used for physical requests and responses</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.CanIdType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>11-Bit</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>29-Bit</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001997CFABFD0' oid='D6A3895F185447b9B24C2EC8CD303FB8' temploid='BE7CF640F91A4563B79BCCC8BDFB0E28' attrcatref='_000001997D1480F0' usage='sys' v='1792' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Request CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The request CAN identifier for physical requests. The hex value not only describes the identifier but also the priority of the message. The higher the number, the lower the priority. </TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.ReqCanId</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFAC1C0' oid='8CCC5B76482D4e57A0C82C743935259F' temploid='B243087B57334b1dBB48E59346E7A3D1' attrcatref='_000001997D1480F0' usage='sys' v='1536' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Response CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The response CAN identifier for physical responses. The response for functional requests is sent via the physical path.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.ResCanId</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFABA00' oid='08F1A603009E4c24B9E937BFC348FF0F' temploid='52D1693361134ba993AED7532DAF53AD' attrcatref='_000001997D1480F0' usage='sys' v='1' df='hex'>
<NAME>
<TUV xml:lang='en-US'>ECU Address</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Physical diagnostic address of the ECU.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.EcuAddress</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFAB240' oid='77931C1911D4443c9A8A12A8315A2565' temploid='4275D40A47AF44c385F98539B00F700E' attrcatref='_000001997D1480F0' usage='sys' v='241' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Tester Address</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Using this Addressing Scheme, the Tester Address can not be determined by the ECU during runtime. Therefore the Tester Address has to be fixed.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.TesterAddress</QUAL>
</UNSDEF>
<ENUMDEF id='_0000019907213E90' oid='9E3849E69ACA44baAA24FCB94838F999' temploid='ED2CB16102334bffAD61DE627CEC64FF' attrcatref='_000001997D1480F0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Functional Addressing Scheme</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Addressing Scheme used for functional requests.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.AddrSchemeFunc</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Normal</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000019907214250' oid='E47E6ED9D7C641a1A443AB6B0B16AD67' temploid='41F09FC50B4F4d5b89531D0F76C84192' attrcatref='_000001997D1480F0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Functional CAN-ID Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>CAN-ID Type used for functional request</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.CanIdTypeFunc</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>11-Bit</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>29-Bit</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001997CFAC3B0' oid='21AFAA4446424939BB0BE38A3AEB8228' temploid='12A346E58CB54d5fBAC75F783E44B68E' attrcatref='_000001997D1480F0' usage='sys' v='1872' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Functional Request CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The request CAN identifier for functional requests.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.ReqCanIdFunc</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFAB620' oid='D582E39169BF4a13888147EAA93DC823' temploid='C5339F4F9C844b86998CAF5A942E7529' attrcatref='_000001997D1480F0' usage='sys' v='1920' df='hex'>
<NAME>
<TUV xml:lang='en-US'>UUDT Response CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>UUDT Response CAN-ID used for multiple responses and/or periodic responses.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.UudtResCanId</QUAL>
</UNSDEF>
<ENUMDEF id='_0000019907213AD0' oid='F4CAD4499C334e4fA56C48266C1F8BBA' temploid='563581C727484a519D3AE67E429A8619' attrcatref='_000001997D1480F0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>UUDT CAN-ID Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Received CAN Format for CAN ID without segmentation (Segment Type Bit must = 0)</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.UudtCanIdType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>11-Bit</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>29-Bit</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001997CFAA4B0' oid='7CA6E8F207DD4b5b8397364E52861E20' temploid='662E369E39BC48fa997459C0EDE7457C' attrcatref='_000001997D149640' usage='sys' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Timeout for the client to wait after the successful transmission of a request message for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.P2Client</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFAA6A0' oid='E0698000DE9A44989076600B1283CF96' temploid='6DE20B79C2514578A743C11036687976' attrcatref='_000001997D149640' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the reception of a request message. In UDS this is the timeout for the default session. The tester will also require the P2Server timeout, since in UDS service "DiagnosticSessionControl" returns the P2Server and P2*Server timeouts – the tester has to calculate the offset manually and has to add it to the returned P2Server and P2*Server timeouts.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.P2Server</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFAC980' oid='B6DFAD965A5A4e7dB94954B04E47EE20' temploid='F4074D0299C240e09363DDD0EE88512D' attrcatref='_000001997D149640' usage='sys' v='2000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2*Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enhanced timeout for the client to wait after the reception of a negative response message with response code 78 hex for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.P2ExClient</QUAL>
</UNSDEF>
<UNSDEF id='_000001997CFABBF0' oid='81554C27CCC54711A2E4C7058764C61D' temploid='CA893E311C3D45d18961C545FAC18AA2' attrcatref='_000001997D149640' usage='sys' v='1950' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2*Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the transmission of a negative response message with response code 78 hex (enhanced response timing). In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.P2ExServer</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907234B50' oid='22B4CBFE2CCB4f2184E40199B489247B' temploid='A8A04B4C8F854fa18E190DE7BEE83447' attrcatref='_000001997D149640' usage='sys' v='4000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between functionally addressed Tester Present request messages transmitted by the client to keep a diagnostic session other than the defaultSession active in multiple servers (functional communication) or maximum time between physically transmitted request messages to a single server (physical communication).</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.S3Client</QUAL>
</UNSDEF>
<UNSDEF id='_00000199072341A0' oid='6CE1DC7FDC0F46c09C8749000A4A2B37' temploid='6C65F79670C245d7A3EE0BDDE899B2EA' attrcatref='_000001997D149640' usage='sys' v='5000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for the server to keep a diagnostic session other than the defaultSession active while not receiving any diagnostic request message</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.S3Server</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907232A60' oid='16EE6BB36B3841369AF9D5C3FC61C8EB' temploid='B2A724BD593D44148396E4EE85BE19A2' attrcatref='_000001997D149640' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3ClientPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time for the client to wait after the successful transmission of a physically addressed request message (indicated via N_USData.con) with no response required before it can transmit the next physically addressed request message.
Minimum value = P2Server</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.P3ClientPhys</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907233DC0' oid='99B5B5E0B049460dACA7498CA4B0D924' temploid='4E46621F04B84eaaA71396EAAF62F484' attrcatref='_000001997D1480F0' usage='sys' v='15872' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterPresentPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the TesterPresent message for physically addressed requests used to keep a diagnostic session active.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.TesterPresentPhys</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907235120' oid='DDEEB8B96401435f9C2C41028A2A8C54' temploid='427EC2D9A36140a98906889FCD4B3ED0' attrcatref='_000001997D149640' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3ClientFunc</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time for the client to wait after the successful transmission of a functionally addressed request message (indicated via N_USData.con) before it can transmit the next functionally addressed request message in case no response is required or the requested data is only supported by a subset of the functionally addressed servers.
Minimum value = P2Server.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.P3ClientFunc</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907231700' oid='BAF36404E9084b1880D0C62ED62FAC41' temploid='6E4F30673B2B43ab85D555399D1C2B24' attrcatref='_000001997D1480F0' usage='sys' v='16000' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterPresentFunc</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the TesterPresent message for functionally addressed requests used to keep a diagnostic session active.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.TesterPresentFunc</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907232C50' oid='4651596C555F4adeB2220B16D2BC8E03' temploid='6F76D43ACC25461cB88189838BB4A06D' attrcatref='_000001997D149640' usage='sys' v='20' df='dec'>
<NAME>
<TUV xml:lang='en-US'>STmin</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>(Separation Time) defines the minimum time gap between consecutive frames. Values from 0x00 to 0x7F (0 – 127) are absolute milliseconds. Values from 0xF1 to 0xF9 are even 100 micro seconds. Every other value range is reserved and should not be used.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.StMin</QUAL>
</UNSDEF>
<UNSDEF id='_00000199072358E0' oid='FA51BA32E06449d3B0F53C04B40451F4' temploid='889C9172A9AC4ed79B9E8D57CCF3EE4F' attrcatref='_000001997D1480F0' usage='sys' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Blocksize</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The Blocksize parameter indicates, how many consecutive frames shall be sent in a transmission before a flow control frame is sent. The number 0 tells the sender, that no more flow controls should disrupt the sending of the remaining flow controls</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.Blocksize</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907233BD0' oid='D53F8B57AADF4f5d98D60B75D554EB02' temploid='6B8F7F93A66D44f6AD9AA83CEB512B4D' attrcatref='_000001997D149640' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout As</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, sender side</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.TimeoutAs</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907235310' oid='223394F49A744f5b991D22D42F2F78C1' temploid='564B273CFC6144139E1D22E4EFBDC776' attrcatref='_000001997D149640' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Ar</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, receiver side</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.TimeoutAr</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907235500' oid='2FCC7D5E931D49f1B103DC0DCAEAEB1F' temploid='0ECE9573CB07491d92A56AF2939D40FF' attrcatref='_000001997D149640' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Bs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next flow control</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.TimeoutBs</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907234770' oid='F52ED9721EF14971AD7E692C6A756D69' temploid='6413AB2CB02A49c8A3474606964958BF' attrcatref='_000001997D149640' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Time Br</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for next transmission of flow control</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.TimeBr</QUAL>
</UNSDEF>
<UNSDEF id='_00000199072356F0' oid='1C6083652E9D43f9A175509C08BC68F9' temploid='4732B9E7E179411d85A48872DD414954' attrcatref='_000001997D149640' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Time Cs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until next transmission of consecutive frame</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.TimeCs</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907233FB0' oid='AA0165F7CF014b8dA7746E0AE4C12FA8' temploid='171DC637A1614685AB49E0243A4A437C' attrcatref='_000001997D149640' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Cr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next consecutive frame</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.TimeoutCr</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907231EC0' oid='230BDA1B286F435a95E5A3B12AC4A02A' temploid='00E719ECCD4D450a87FEFBFC3791352F' attrcatref='_000001997D1480F0' usage='sys' v='4095' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Max Length of TP Message</TUV>
</NAME>
<QUAL>CAN_Extended_Addressing.MaxLengthTpMessage</QUAL>
</UNSDEF>
<UNSDEF id='_00000199072318F0' oid='2A1F530C8C6E4f48A89292508F53F923' temploid='B0AC36FDA82F488bB33BE00096BEF13E' attrcatref='_000001997D1480F0' usage='sys' v='500000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Baudrate</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Bus Speed of the used transport media. Caution, the Bus Speed has to be set identical in all ECUs connected to one subnet.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.Baudrate</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907233030' oid='917923CCAB374cecB678CF6128171AC5' temploid='2F06D8E6FD914fe8BC76D372195BB11E' attrcatref='_000001997D1480F0' usage='sys' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>CANFrameFillerByte</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Fill byte used for filling CAN frames to eight byte length.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.CANFrameFillerByte</QUAL>
</UNSDEF>
<ENUMDEF id='_0000019907212630' oid='B315D5CE09DF4823BE172C7A5427E0ED' temploid='A7247727EC744b20B821C92EF33A7631' attrcatref='_000001997D1480F0' usage='sys' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FillerByteHandling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enables use of fill bytes; if "true", fill bytes are used, otherwise DLC may be smaller than 8.</TUV>
</DESC>
<QUAL>CAN_Extended_Addressing.FillerByteHandling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>false</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>true</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_00000199072129F0' oid='3D21B165FCB64570A77E8DBDFDEC191F' temploid='9140ACFA97F74f9bBF3A4EF8A0E67725' attrcatref='_000001997D1499B0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FlexRay (ISO10681 TP)</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Communication interface for FlexRay protocol. Based on the specification: ISO10681-2 "Road vehicles —  Communication on FlexRay —  Part 2: Communication Layer services". ISO document date 2009-10-23.</TUV>
</DESC>
<QUAL>FlexRay_ISO</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>not supported</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>supported</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000019907213CB0' oid='6A11CB80F4D049d2A6F972B32E6CA932' temploid='33CEBBC4A37D42e9864330AA45647A0B' attrcatref='_000001997D1480F0' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>BusType</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of transport media.</TUV>
</DESC>
<QUAL>FlexRay_ISO.BusType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>FlexRay</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_0000019907234390' oid='5DF40ACFF7644e1c8A1187F5C8FC5FD8' temploid='70F7576FC2FE4822A04B83E47CD338B4' attrcatref='_000001997D149640' usage='admin' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Timeout for the client to wait after the successful transmission of a request message for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>FlexRay_ISO.CP_P2Max</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907231CD0' oid='9E71F0B46EC847a489BB7DAE16B2F645' temploid='8EC2C7175F2B4d818E1022DACCFA3FDB' attrcatref='_000001997D149640' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the reception of a request message. In UDS this is the timeout for the default session. The tester will also require the P2Server timeout, since in UDS service "DiagnosticSessionControl" returns the P2Server and P2*Server timeouts – the tester has to calculate the offset manually and has to add it to the returned P2Server and P2*Server timeouts.</TUV>
</DESC>
<QUAL>FlexRay_ISO.CP_P2Max_Ecu</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907235AD0' oid='C5E6B50E4755478dAF18AEAC321CC095' temploid='BD3EFAECE9A94870820237F2681570F1' attrcatref='_000001997D149640' usage='admin' v='2000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2ExClient</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enhanced timeout for the client to wait after the reception of a negative response message with response code 78 hex for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>FlexRay_ISO.CP_P2Star</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907234580' oid='8687E8637FBB47a998911670B1767273' temploid='84FB63DDF991405eB1962B6090375E6B' attrcatref='_000001997D149640' usage='admin' v='1950' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2ExServer</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the transmission of a negative response message with response code 78 hex (enhanced response timing). In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>FlexRay_ISO.CP_P2Star_Ecu</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907234960' oid='D282F0B043774707911F3D438E41EB06' temploid='029A47066FD647c4B72C2B560271E12B' attrcatref='_000001997D149640' usage='admin' v='4000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between functionally addressed Tester Present request messages transmitted by the client to keep a diagnostic session other than the defaultSession active in multiple servers (functional communication) or maximum time between physically transmitted request messages to a single server (physical communication).</TUV>
</DESC>
<QUAL>FlexRay_ISO.CP_TesterPresentTime</QUAL>
</UNSDEF>
<UNSDEF id='_00000199072339E0' oid='A4089C202D3240749E871A2FFD219366' temploid='1AC44FF91BD849239B3ACE94FFE11CA7' attrcatref='_000001997D149640' usage='admin' v='5000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for the server to keep a diagnostic session other than the defaultSession active while not receiving any diagnostic request message.</TUV>
</DESC>
<QUAL>FlexRay_ISO.CP_TesterPresentTime_Ecu</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907234D40' oid='6B20356E6A1B454791ECA063B8B5AE60' temploid='C8C69719A4CA4aa1A9738A21A869B818' attrcatref='_000001997D149640' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3ClientPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time for the client to wait after the successful transmission of a physically addressed request message with no response required before it can transmit the next physically addressed request message. Minimum value = P2Server.</TUV>
</DESC>
<QUAL>FlexRay_ISO.CP_P3Phys</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907234F30' oid='E61F64E48CDD4476B3A2D3DA6D9A18C8' temploid='0CC842BEF51C4983B9947BE3CD20A1D4' attrcatref='_000001997D1480F0' usage='admin' v='17476' df='hex'>
<NAME>
<TUV xml:lang='en-US'>EcuAddress</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the ecu address. Messages addressed to the ecu will contain this address as target address within the message header.</TUV>
</DESC>
<QUAL>FlexRay_ISO.EcuAddress</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907231AE0' oid='8A87417AEC2647aaAC0A3CC1878CE4C9' temploid='AD158C32DBBE489c8196B940E0E4A4AA' attrcatref='_000001997D1480F0' usage='admin' v='4660' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterAddress</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the tester address. Messages addressed to the ecu will contain this address as source address within the message header.</TUV>
</DESC>
<QUAL>FlexRay_ISO.TesterAddress</QUAL>
</UNSDEF>
<CSTRDEF id='_00000199071EE180' oid='3FA1AACB56D14766810B1365248E3171' temploid='B200EA78E1A549afB8DC166BABC13460' attrcatref='_000001997D1480F0' usage='admin'>
<NAME>
<TUV xml:lang='en-US'>PDUListReqPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the physical request channel. Can be single PDU or multiple Slots (comma separated list).</TUV>
</DESC>
<QUAL>FlexRay_ISO.PDUListReqPhys</QUAL>
<COMMONSTRING></COMMONSTRING>
</CSTRDEF>
<CSTRDEF id='_00000199071EEC60' oid='BDF45A1B342A4a1aAC39191C0184AA53' temploid='68D2120C1F60404f87CE55D4C6EB2938' attrcatref='_000001997D1480F0' usage='admin'>
<NAME>
<TUV xml:lang='en-US'>PDUListRes</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the physical response channel. Can be single PDU or multiple Slots (comma separated list).</TUV>
</DESC>
<QUAL>FlexRay_ISO.PDUListRes</QUAL>
<COMMONSTRING></COMMONSTRING>
</CSTRDEF>
<ENUMDEF id='_0000019907212810' oid='EEC716CCEB9746b296AD96EED29048B9' temploid='8DB2F87211044f2d9CA09184F740E135' attrcatref='_000001997D1480F0' usage='admin' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FillerByteHandling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enables or disables frame padding (0 = false, 1 = true).</TUV>
</DESC>
<QUAL>FlexRay_ISO.FillerByteHandling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>false</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>true</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_0000019907232E40' oid='858F53642E974b21812E0AF59A368DCA' temploid='E73A82A5B97D4b2784C2B26F242B63DD' attrcatref='_000001997D1480F0' usage='admin' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>FrFrameFillerByte</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Byte value that is used for frame padding, if padding is enabled.</TUV>
</DESC>
<QUAL>FlexRay_ISO.FrFrameFillerByte</QUAL>
</UNSDEF>
<ENUMDEF id='_00000199072511D0' oid='3060DC0E19C6444fAB2AE3AA8A5D5852' temploid='DCBABFB31D604897B9E4DE06F05118BC' attrcatref='_000001997D1480F0' usage='admin' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>AutoP2Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Support ISO14229 DiagnosticSessionControl service's influence on P2 (P2Client and P2ExClient) timings. Depending on the configured value, the timings will be updated or not (0 = Disabled, 1 = Enabled).</TUV>
</DESC>
<QUAL>FlexRay_ISO.AutoP2Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001990724FD30' oid='BAEA461766374cb6985C4AEF3C62D429' temploid='F205B2F7B6DB4872A68F383931A14842' attrcatref='_000001997D1480F0' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>RC21Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Repetition mode in case of KWP2000 negative response code 0x21 busy – repeat request (0 = Disabled, 1 = Enabled, 2 = EnabledUnlimited).</TUV>
</DESC>
<QUAL>FlexRay_ISO.RC21Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>EnabledUnlimited</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_0000019907235EB0' oid='FBD506FD272242acB3D4F7DF242A0726' temploid='C2B4D1A56E6640d3AF4AC098B0361A70' attrcatref='_000001997D149640' usage='admin' v='10' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC21RequestTime</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between negative response with response code 0x21 and the retransmission of the same request. If P3ClientPhys is greater than RC21RequestTime, the time delay prior to the retransmission of the same request will be P3ClientPhys.</TUV>
</DESC>
<QUAL>FlexRay_ISO.RC21RequestTime</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907233220' oid='1D52939CD4604bcfBEAFA9D6A2CD18C3' temploid='D6DA064AAF6D4c86A788F905E4B8424E' attrcatref='_000001997D149640' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC21CompletionTimeout</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time period the tester accepts repeated negative responses with response code 0x21 and repeats the same request. Timer is started after reception of first negative response.</TUV>
</DESC>
<QUAL>FlexRay_ISO.RC21CompletionTimeout</QUAL>
</UNSDEF>
<ENUMDEF id='_0000019907250E10' oid='7F0E9C53A3484070AFC1E075F5583928' temploid='94BF4EDEC6954ddb9384F01136C1ADBF' attrcatref='_000001997D1480F0' usage='admin' v='2' sort='id'>
<NAME>
<TUV xml:lang='en-US'>RC78Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Handling of 0x7F XX 0x78 ResponseTimeout and 0x78 repetitions (0 = Disabled, 1 = Enabled, 2 = EnabledUnlimited).</TUV>
</DESC>
<QUAL>FlexRay_ISO.RC78Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>EnabledUnlimited</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_00000199072360A0' oid='C3CD870D87AF4bf59AC34E1A32EB0F1B' temploid='2BF78B811A324c1c8044F4CE5BFA9A27' attrcatref='_000001997D149640' usage='admin' v='30000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC78CompletionTimeout</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time period the tester accepts repeated negative responses with response code 0x78 and waits for a positive response further on.</TUV>
</DESC>
<QUAL>FlexRay_ISO.RC78CompletionTimeout</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907236290' oid='E94282CF9C9446e29E43C0DDB11B3FC0' temploid='1EEFB143154F46cbAC228B655D0E3465' attrcatref='_000001997D149640' usage='admin' v='125' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutAr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, receiver side.</TUV>
</DESC>
<QUAL>FlexRay_ISO.TimeoutAr</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907233410' oid='D297B4615E424c898949FDF3A69DA1C6' temploid='D1E091DCEA58401d8E785E4F95701AB6' attrcatref='_000001997D149640' usage='admin' v='125' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutAs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, sender side.</TUV>
</DESC>
<QUAL>FlexRay_ISO.TimeoutAs</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907233600' oid='26102FA5A1DF488298CA095A80ADF69D' temploid='354CF428AFD94482B926762C57741C16' attrcatref='_000001997D149640' usage='admin' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeBr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for next transmission of flow control.</TUV>
</DESC>
<QUAL>FlexRay_ISO.TimeBr</QUAL>
</UNSDEF>
<UNSDEF id='_00000199072322A0' oid='7AC9B61B76294c10910CDD1A0AFCB815' temploid='84D28D8C58874cc5B0B574605077DE69' attrcatref='_000001997D149640' usage='admin' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutBs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next flow control.</TUV>
</DESC>
<QUAL>FlexRay_ISO.TimeoutBs</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907236480' oid='3911A04BE9DD4889B779C7868EB3F98E' temploid='A04A9E86B2B94caaA91E5C6795BD6737' attrcatref='_000001997D149640' usage='admin' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutCr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next consecutive frame.</TUV>
</DESC>
<QUAL>FlexRay_ISO.TimeoutCr</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907232490' oid='352CC487FAF949259FAB072452A4BFA5' temploid='837ABFA51F67400f9881644424C1C754' attrcatref='_000001997D149640' usage='admin' v='25' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeCs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until next transmission of consecutive frame.</TUV>
</DESC>
<QUAL>FlexRay_ISO.TimeCs</QUAL>
</UNSDEF>
<ENUMDEF id='_0000019907250FF0' oid='E7EB1EAD2CCD4f6794207111C9005EB0' temploid='9DF031080C154b54AECE6D726B3D6AC0' attrcatref='_000001997D1480F0' usage='admin' v='3' sort='id'>
<NAME>
<TUV xml:lang='en-US'>TransportProtocolType</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the used FlexRay Transport Protocol Type (0 = Autosar2x, 1 = Autosar30, 2 = BMW, 3 = ISO10681).</TUV>
</DESC>
<QUAL>FlexRay_ISO.TransportProtocolType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Autosar2x</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Autosar30</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>BMW</TUV>
</ETAG>
<ETAG v='3'>
<TUV xml:lang='en-US'>ISO10681</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000019907250A50' oid='E69E2A8B12D946a8B50FABF8B9448423' temploid='521A0E12921B4ff7A6DB76FDC897E063' attrcatref='_000001997D1480F0' usage='admin' v='2' sort='id'>
<NAME>
<TUV xml:lang='en-US'>ConnectionModePhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the Connection Mode for physical requests (1 = UnAckUnicast, 2 = AckUnicast, 3 = AckRetryUnicast).</TUV>
</DESC>
<QUAL>FlexRay_ISO.ConnectionModePhys</QUAL>
<ETAG v='1'>
<TUV xml:lang='en-US'>UnAckUnicast</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>AckUnicast</TUV>
</ETAG>
<ETAG v='3'>
<TUV xml:lang='en-US'>AckRetryUnicast</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_0000019907236670' oid='F2DB909F14D34172A5651426D337A0A1' temploid='4A9E565D49D9477aAEBEF8E627CCF9BE' attrcatref='_000001997D1480F0' usage='admin' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>BufferSize</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The maximum number of data bytes the receiver allows the sender to send via CFs, before waiting for an authorization to continue transmission of the following data bytes via further CFs.</TUV>
</DESC>
<QUAL>FlexRay_ISO.BufferSize</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907236860' oid='F96DBDB575224858B0451778D98448F9' temploid='7C4DBA11629147e59A9B8E78043FED9B' attrcatref='_000001997D1480F0' usage='admin' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>BandwidthControl</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>By means of the BandwithControl (BC) parameter, the receiver reports its receiving performance level to the sender, i.e. the maximum bandwidth it can receive. The BC parameter is a one byte value.</TUV>
</DESC>
<QUAL>FlexRay_ISO.BandwidthControl</QUAL>
</UNSDEF>
<ENUMDEF id='_00000199072513B0' oid='81ED824657FD46459C8A7BAD1E73D81B' temploid='32A3C96F7AA34c39B4C850C47F9F71BF' attrcatref='_000001997D1499B0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FlexRay (Autosar2x TP)</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Communication interface for FlexRay protocol. Based on the Autosar2x specific transport protocol.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>not supported</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>supported</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001990724FF10' oid='3C10D9A35C454d13B40B8DFB74E443BB' temploid='BD9E41A1968E4e3f9C8E6AF913209C6A' attrcatref='_000001997D1480F0' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>BusType</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of transport media.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.BusType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>FlexRay</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_0000019907232870' oid='56B803E910B94630BEF2FEB8377E4814' temploid='6E4757A190FE46889462329EED761870' attrcatref='_000001997D149640' usage='admin' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Timeout for the client to wait after the successful transmission of a request message for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.CP_P2Max</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907236A50' oid='4991C2112900456594DB5D75283A5A86' temploid='A9ED920EA45940219DB2B66C77B4F05C' attrcatref='_000001997D149640' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the reception of a request message. In UDS this is the timeout for the default session. The tester will also require the P2Server timeout, since in UDS service "DiagnosticSessionControl" returns the P2Server and P2*Server timeouts – the tester has to calculate the offset manually and has to add it to the returned P2Server and P2*Server timeouts.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.CP_P2Max_Ecu</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907238D30' oid='AD8E142F9FBC42b19B4F7804D0D16F56' temploid='D878BEE8217540be9FDE0C6832D71C8D' attrcatref='_000001997D149640' usage='admin' v='2000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2ExClient</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enhanced timeout for the client to wait after the reception of a negative response message with response code 78 hex for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.CP_P2Star</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907236C40' oid='4EBF4DABDAF240a6A128536B50257C36' temploid='632B7BC788384317809CC3DD68315FCE' attrcatref='_000001997D149640' usage='admin' v='1950' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2ExServer</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the transmission of a negative response message with response code 78 hex (enhanced response timing). In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.CP_P2Star_Ecu</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907237400' oid='A792B76ECEDF42309F968FCDD36D573E' temploid='C930B65DE35E47d096EDC6DE61AD39EC' attrcatref='_000001997D149640' usage='admin' v='4000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between functionally addressed Tester Present request messages transmitted by the client to keep a diagnostic session other than the defaultSession active in multiple servers (functional communication) or maximum time between physically transmitted request messages to a single server (physical communication).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.CP_TesterPresentTime</QUAL>
</UNSDEF>
<UNSDEF id='_00000199072377E0' oid='1F976727A196425eADB4240DF0F33CC7' temploid='8883A3FDEDED4235B593497A15AC0730' attrcatref='_000001997D149640' usage='admin' v='5000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for the server to keep a diagnostic session other than the defaultSession active while not receiving any diagnostic request message.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.CP_TesterPresentTime_Ecu</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907238F20' oid='EA8BABEED2A544af89C444933A67222A' temploid='5F401A1E9BA14b49B8109428C9BF85C5' attrcatref='_000001997D149640' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3ClientPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time for the client to wait after the successful transmission of a physically addressed request message with no response required before it can transmit the next physically addressed request message. Minimum value = P2Server.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.CP_P3Phys</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907236E30' oid='574B514AA2A94ab4B421D0B7B98814FC' temploid='54151AAD5ABF403eA5CFE80E63E403A0' attrcatref='_000001997D1480F0' usage='admin' v='17476' df='hex'>
<NAME>
<TUV xml:lang='en-US'>EcuAddress</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the ecu address. Messages addressed to the ecu will contain this address as target address within the message header.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.EcuAddress</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907237DB0' oid='0CCF214B60E842d5AB3AA02481B53055' temploid='1CB805F360DB4ed08C26C250C312F0C4' attrcatref='_000001997D1480F0' usage='admin' v='4660' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterAddress</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the tester address. Messages addressed to the ecu will contain this address as source address within the message header.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TesterAddress</QUAL>
</UNSDEF>
<CSTRDEF id='_00000199071EE520' oid='2C8D35EB19F74f4088BAFDF8163627A9' temploid='B4D69B1B1E494dedA5872F3FDC9D1F45' attrcatref='_000001997D1480F0' usage='admin'>
<NAME>
<TUV xml:lang='en-US'>PDUListReqPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the physical request channel. Can be single PDU or multiple Slots (comma separated list).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.PDUListReqPhys</QUAL>
<COMMONSTRING></COMMONSTRING>
</CSTRDEF>
<CSTRDEF id='_00000199071EE6F0' oid='3887D23A10FB4838BFFDE30DFCEDCD5A' temploid='11C421A54B224f67951029A4F6F71E73' attrcatref='_000001997D1480F0' usage='admin'>
<NAME>
<TUV xml:lang='en-US'>PDUListRes</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the physical response channel. Can be single PDU or multiple Slots (comma separated list).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.PDUListRes</QUAL>
<COMMONSTRING></COMMONSTRING>
</CSTRDEF>
<ENUMDEF id='_00000199072500F0' oid='6CF71A3316574a30B0194A0E16565468' temploid='D4EC4ACB48D24f59B4F5C5641D6E1700' attrcatref='_000001997D1480F0' usage='admin' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FillerByteHandling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enables or disables frame padding (0 = false, 1 = true).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.FillerByteHandling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>false</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>true</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_0000019907237020' oid='B91E961818384f2dB2F5268E55E00260' temploid='934EF1A297C84a508F66D02197BA834A' attrcatref='_000001997D1480F0' usage='admin' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>FrFrameFillerByte</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Byte value that is used for frame padding, if padding is enabled.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.FrFrameFillerByte</QUAL>
</UNSDEF>
<ENUMDEF id='_000001990724F790' oid='38009003059945ee99084695812FAC9C' temploid='6500441CC5244372BEFFA6C9B0806174' attrcatref='_000001997D1480F0' usage='admin' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>AutoP2Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Support ISO14229 DiagnosticSessionControl service's influence on P2 (P2Client and P2ExClient) timings. Depending on the configured value, the timings will be updated or not (0 = Disabled, 1 = Enabled).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.AutoP2Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001990724FB50' oid='64B0BF882F114276AE1E76230FA4E31B' temploid='5FDD91F76BA94698A59E5B061D122E44' attrcatref='_000001997D1480F0' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>RC21Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Repetition mode in case of KWP2000 negative response code 0x21 busy – repeat request (0 = Disabled, 1 = Enabled, 2 = EnabledUnlimited).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.RC21Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>EnabledUnlimited</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_0000019907237FA0' oid='CA4AE0EA31FA46d4A2F1224DE50477D3' temploid='6D6BC198D69E4456A13AA2D596C01E06' attrcatref='_000001997D149640' usage='admin' v='10' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC21RequestTime</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between negative response with response code 0x21 and the retransmission of the same request. If P3ClientPhys is greater than RC21RequestTime, the time delay prior to the retransmission of the same request will be P3ClientPhys.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.RC21RequestTime</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907239110' oid='9719BD153DC04e91B031E701C0D9CC63' temploid='E825BA4142BB406aB7653A854A89FEE8' attrcatref='_000001997D149640' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC21CompletionTimeout</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time period the tester accepts repeated negative responses with response code 0x21 and repeats the same request. Timer is started after reception of first negative response.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.RC21CompletionTimeout</QUAL>
</UNSDEF>
<ENUMDEF id='_00000199072502D0' oid='5458D296017E4228A93515680C52109E' temploid='2F76FB3BE60E4938821E4D5B2A752F8A' attrcatref='_000001997D1480F0' usage='admin' v='2' sort='id'>
<NAME>
<TUV xml:lang='en-US'>RC78Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Handling of 0x7F XX 0x78 ResponseTimeout and 0x78 repetitions (0 = Disabled, 1 = Enabled, 2 = EnabledUnlimited).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.RC78Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>EnabledUnlimited</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_0000019907238190' oid='E71056813FF24b8c85EE4C570BA3CA48' temploid='16820517C2424af29D328640DD8C2838' attrcatref='_000001997D149640' usage='admin' v='30000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC78CompletionTimeout</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time period the tester accepts repeated negative responses with response code 0x78 and waits for a positive response further on.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.RC78CompletionTimeout</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907237210' oid='68789561D60D452d92BF16B5696F1029' temploid='396C69C6664E440b88F1FF12D34AC5FF' attrcatref='_000001997D149640' usage='admin' v='125' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutAr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, receiver side.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TimeoutAr</QUAL>
</UNSDEF>
<UNSDEF id='_00000199072379D0' oid='2BBD257ABE9A427b8FCFAE60FE631EAA' temploid='B7AA8A765BE54a93BB4F88F62A396D21' attrcatref='_000001997D149640' usage='admin' v='125' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutAs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, sender side.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TimeoutAs</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907237BC0' oid='87253A921B6C40f0BCDCE930A06C1FEC' temploid='E54498A726E44f8896AC346FDF1CA3F6' attrcatref='_000001997D149640' usage='admin' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeBr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for next transmission of flow control.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TimeBr</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907238380' oid='1C48C6F8509A4aa8835E13A80528A398' temploid='8BDA3F5AE07B41ca8E81E2D1B9CF7CD2' attrcatref='_000001997D149640' usage='admin' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutBs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next flow control.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TimeoutBs</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907238570' oid='93B55A1C489D4ba399BA6619EC8C5610' temploid='349ED325C93545cb9E3304432EBA13F4' attrcatref='_000001997D149640' usage='admin' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutCr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next consecutive frame.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TimeoutCr</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907238760' oid='62E5C9E021E64572BE9160FAF017C3EE' temploid='42BCD1EF169741e1B69634578F8676A2' attrcatref='_000001997D149640' usage='admin' v='25' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeCs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until next transmission of consecutive frame.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TimeCs</QUAL>
</UNSDEF>
<ENUMDEF id='_0000019907250C30' oid='8CF6407491B848c4B18896DF24A0813F' temploid='334FB71DB7E84bc4854CF227622DFF90' attrcatref='_000001997D1480F0' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>TransportProtocolType</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the used FlexRay Transport Protocol Type (0 = Autosar2x, 1 = Autosar30, 2 = BMW, 3 = ISO10681).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TransportProtocolType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Autosar2x</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Autosar30</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>BMW</TUV>
</ETAG>
<ETAG v='3'>
<TUV xml:lang='en-US'>ISO10681</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001990724F970' oid='72A99B0377E2446a8FD62B01666EA85F' temploid='1F6DB6AC8D814fd8B9D59214FD564134' attrcatref='_000001997D1480F0' usage='admin' v='2' sort='id'>
<NAME>
<TUV xml:lang='en-US'>ConnectionModePhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the Connection Mode for physical requests (1 = UnAckUnicast, 2 = AckUnicast, 3 = AckRetryUnicast).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.ConnectionModePhys</QUAL>
<ETAG v='1'>
<TUV xml:lang='en-US'>UnAckUnicast</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>AckUnicast</TUV>
</ETAG>
<ETAG v='3'>
<TUV xml:lang='en-US'>AckRetryUnicast</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_00000199072504B0' oid='13F5AFF8C7814aae9AD91DBF1EBDE26A' temploid='97CA9B86154847e28BACB06B8C42E8DF' attrcatref='_000001997D1480F0' usage='admin' v='3' sort='id'>
<NAME>
<TUV xml:lang='en-US'>MessageLength</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Message Length of physically addressed request (= message length mode (Autosar FlexRay TP 2.1, 10.2.3): ISO = 1 (up to 4095 bytes, do not use extended frame types), ISO6 = 2 (as ISO, but payload length is limited to 6 bytes), L16M = 3 (up to 2^24-1 bytes, E4 frames not allowed), L4G = 4 (up to 2^32-1 bytes, all frames allowed).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.MessageLengthPhys</QUAL>
<ETAG v='1'>
<TUV xml:lang='en-US'>ISO</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>ISO6</TUV>
</ETAG>
<ETAG v='3'>
<TUV xml:lang='en-US'>L16M</TUV>
</ETAG>
<ETAG v='4'>
<TUV xml:lang='en-US'>L4G</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_0000019907239300' oid='E91299EB9FE645e69ABDD49E058ADD27' temploid='82B4B7AA84234210BF00938160962744' attrcatref='_000001997D1480F0' usage='admin' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>BlockSize</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The Block Size parameter indicates, how many consecutive frames shall be sent in a transmission before a flow control frame is sent. The number 0 tells the sender, that no more flow controls should disrupt the sending of the remaining flow controls.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.BlockSize</QUAL>
</UNSDEF>
<UNSDEF id='_00000199614726B0' oid='5C64707457AB474eB86755AA6980D800' temploid='E6DBF459978849418B19F9B66037DAD5' attrcatref='_000001997D1480F0' usage='admin' v='20' df='dec'>
<NAME>
<TUV xml:lang='en-US'>SeparationTime</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Separation Time defines the minimum time gap between consecutive frames. Values from 0x00 to 0x7F (0 – 127) are absolute milliseconds. Values from 0xF1 to 0xF9 are even 100 micro seconds. Every other value range is reserved and should not be used.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.StMin</QUAL>
</UNSDEF>
<ENUMDEF id='_0000019907250690' oid='A4FAF37F2B394b2eB4E760FF7D758ADB' temploid='74872A8635B64042BB1F8CC5A66F0FD7' attrcatref='_000001997D1480F0' usage='admin' v='2' sort='id'>
<NAME>
<TUV xml:lang='en-US'>AddressTypePhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the number of address bytes used within the header of physically addressed messages (1 = 1 byte addresses, 2 = 2 byte addresses).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.AddressTypePhys</QUAL>
<ETAG v='1'>
<TUV xml:lang='en-US'>1</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>2</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000019907250870' oid='9BC5D19EF9EA427d891F113F31871EB3' temploid='6EF520FB4D0F4063B1A8DF0E69763B30' attrcatref='_000001997D1480F0' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>RC21Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Repetition mode in case of negative response code 0x21 (busy – repeat request)</TUV>
</DESC>
<QUAL>CAN.RC21Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>EnabledUnlimited</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001997CFACB70' oid='0A4870F563A4432188D4271E232272BD' temploid='61C80B8BCC7D427dBBEF92C8405BF9C1' attrcatref='_000001997D149640' usage='admin' v='10' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC21RequestTime</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between negative response with response code 0x21 and the retransmission of the same request. If P3ClientPhys is greater than RC21RequestTime, the time delay prior to the retransmission of the same request will be P3ClientPhys.</TUV>
</DESC>
<QUAL>CAN.RC21RequestTime</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907281570' oid='89F533AA40CD46a8AFF12EA1F2E35431' temploid='0A341948E43544d887C13C5D324C0C9E' attrcatref='_000001997D149640' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC21CompletionTimeout</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time period the tester accepts repeated negative responses with response code 0x21 and repeats the same request. Timer is started after reception of first negative response.</TUV>
</DESC>
<QUAL>CAN.RC21CompletionTimeout</QUAL>
</UNSDEF>
<ENUMDEF id='_00000199072883B0' oid='C51D39CF3A494a91AD73BD3250E4AFE8' temploid='7268DB599AC64e5d9675DC146B26FEFF' attrcatref='_000001997D1480F0' usage='admin' v='2' sort='id'>
<NAME>
<TUV xml:lang='en-US'>RC78Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Handling of 0x7F XX 0x78 ResponseTimeout and 0x78 Repetitions</TUV>
</DESC>
<QUAL>CAN.RC78Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>EnabledUnlimited</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001990727FC40' oid='AA516E743FFD4c0d9451D316D09BF8BA' temploid='1675EDE511E34a08967F2E7DBD849291' attrcatref='_000001997D149640' usage='admin' v='30000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC78CompletionTimeout</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time period the tester accepts repeated negative responses with response code 0x78 and waits for a positive response further on</TUV>
</DESC>
<QUAL>CAN.RC78CompletionTimeout</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907283850' oid='D53801193F5F408eB9BE00BA50CB8DD0' temploid='A08F84D629CC4cd99C36F8828F0531C1' attrcatref='_000001997D148300' v='1000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Periodic Rate (Slow) in ms</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Only exported if Service $2A with transmissionMode $01 (sendAtSlowRate) is supported.</TUV>
</DESC>
<QUAL>Periodic_Rate_Slow_in_ms</QUAL>
</UNSDEF>
<UNSDEF id='_0000019907280020' oid='59434E42DD1C41a99B94DAF18FE261B1' temploid='FBE63A8D027B419394833B66F9950CA4' attrcatref='_000001997D148300' v='100' df='dec'>
