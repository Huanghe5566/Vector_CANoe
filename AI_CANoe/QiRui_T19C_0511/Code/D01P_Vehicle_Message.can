on message RLCR_3
{
  int i;
  byte MSG_RawData[64];
  MSG_RawData[22]=0xA7;
  MSG_RawData[23]=0x03;
  for (i = 0; i < 22; i++)
  {
    MSG_RawData[i] = this.byte(i+2);   

  }
  @sysvar::Vehicle_input::Message_CRC::RLCR_3_0x3A7 = ssh_crc16_cheery(MSG_RawData,24);
  if ((this.byte(0)<<8 | this.byte(1))== (@sysvar::Vehicle_input::Message_CRC::RLCR_3_0x3A7))
  {
    @sysvar::Vehicle_input::MSG::RLCR_3_0x3A7 = 1;
  }
  else 
  {
    @sysvar::Vehicle_input::MSG::RLCR_3_0x3A7 = 0;
  }
}

