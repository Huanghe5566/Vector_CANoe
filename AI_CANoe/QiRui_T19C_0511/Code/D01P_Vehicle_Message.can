  MSG_RawData[1]=0x00;
  for (i = 0; i < 8; i++)
  {
    MSG_RawData[i+2] = this.byte(i+1);   
  }
  @sysvar::Vehicle_input::Message_CRC::RRCR_1_0x4F3 = E2E_CRC8(MSG_RawData,9);
  if (this.byte(0) == (@sysvar::Vehicle_input::Message_CRC::RRCR_1_0x4F3))
  {
  @sysvar::Vehicle_input::MSG::RRCR_1_0x4F3 = 1;
  }
  else 
  {
    @sysvar::Vehicle_input::MSG::RRCR_1_0x4F3 = 0;
  }
}
