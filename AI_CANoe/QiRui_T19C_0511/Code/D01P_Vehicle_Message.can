on message RRCR_3
{
  int i;
  byte MSG_RawData[64];
  MSG_RawData[22]=0xBF;
  MSG_RawData[23]=0x03;
  for (i = 0; i < 22; i++)
  {
    MSG_RawData[i] = this.byte(i+2);   
  }
  @sysvar::Vehicle_input::Message_CRC::RRCR_3_0x3BF = ssh_crc16_cheery(MSG_RawData,24);
  //write("@sysvar::Vehicle_input::Message_CRC::RRCR_3_0x3BF = %d", @sysvar::Vehicle_input::Message_CRC::RRCR_3_0x3BF);
  //write("(this.byte(0)<<8 | this.byte(1)) = %d", (this.byte(0)<<8 | this.byte(1)));
  if ((this.byte(0)<<8 | this.byte(1)) == (@sysvar::Vehicle_input::Message_CRC::RRCR_3_0x3BF))
  {
    
    @sysvar::Vehicle_input::MSG::RRCR_3_0x3BF = 1;
    //write(" @sysvar::Vehicle_input::MSG::RRCR_3_0x3BF = %d", @sysvar::Vehicle_input::MSG::RRCR_3_0x3BF = 1);
    
  }
  else 
  {
    @sysvar::Vehicle_input::MSG::RRCR_3_0x3BF = 0;
  }
}



//Calculation of a checksum and a message counter 示例:
dword applILTxPending (long aId, dword aDlc, byte data[]) // 在CANoe交互层（CANoe IL）向总线发送消息之前，调用此回调。
{
  dword i;
  byte MSG_Data[64];  //存储报文
  byte result_crc;
  
  //0x098 ONEBOX_1
  if(aId == 0x98)  //写 message ID
  {
    if(@ sysvar::Vehicle_input::Message_Counter::ONEBOX_1_0x98_RC1 ==1)
    {
      int current_counter;
      current_counter++;
      //write("the current counter is %d",current_counter);
      if(current_counter >= @sysvar::Vehicle_input::Message_Counter::Counter_unchange)
      {
        @ sysvar::Vehicle_input::Message_Counter::ONEBOX_1_0x98_RC1 = 0;
        current_counter = 0;
      }
    }
    else
    {
      data[1] = E2E_Counter(data,1);
      //set the new checksum
      MSG_Data[0] = 0x49; // 将CANID 添加进待校验的数组  
      MSG_Data[1] = 0x00;
      for(i = 1; i < 7; i++)
      {
        MSG_Data[i+1] = data[i];  // 将前7个Byte添加进待校验的数组 
      }
      data[0]  = E2E_CRC8(MSG_Data, 9) + @sysvar::Vehicle_input::Message_CRC::ONEBOX_1_0x98_CRC1;  // 要校验的数据为 DataID + CRC外的7个Byte 
    }
    if(@ sysvar::Vehicle_input::Message_Counter::ONEBOX_1_0x98_RC2 ==1)
    {
      int current_counter;
      current_counter++;
      //write("the current counter is %d",current_counter);
      if(current_counter >= @sysvar::Vehicle_input::Message_Counter::Counter_unchange)
      {
        @ sysvar::Vehicle_input::Message_Counter::ONEBOX_1_0x98_RC2 = 0;
        current_counter = 0;
      }
    }
    else
    {
      data[9] = E2E_Counter(data,9);
      MSG_Data[0] = 0x4A;
      MSG_Data[1] = 0x00;
      for(i = 1; i < 7; i++)
      {
        MSG_Data[i+1] = data[i+8];
      }
      data[8]  = E2E_CRC8(MSG_Data,9) + @sysvar::Vehicle_input::Message_CRC::ONEBOX_1_0x98_CRC2;
    }
  }
  
  //0x22B ONEBOX_3
  if(aId == 0x22B)
  {
    if(@sysvar::Vehicle_input::Message_Counter::ONEBOX_3_0x22B_RC1 ==1)
    {
      int current_counter;
      current_counter++;
      if(current_counter >= @sysvar::Vehicle_input::Message_Counter::Counter_unchange)
      {
        @sysvar::Vehicle_input::Message_Counter::ONEBOX_3_0x22B_RC1 = 0;
        current_counter = 0;
      }
    }
    else
    {
      data[1] = E2E_Counter(data,1);
      MSG_Data[0] = 0x4D;
      MSG_Data[1] = 0x00;
      for(i = 1; i < 7; i++)
      {
        MSG_Data[i+1] = data[i]; 
      }
      data[0]  = E2E_CRC8(MSG_Data,9) + @sysvar::Vehicle_input::Message_CRC::ONEBOX_3_0x22B_CRC1;
    }
    if(@sysvar::Vehicle_input::Message_Counter::ONEBOX_3_0x22B_RC2 ==1)
    {
      int current_counter;
      current_counter++;
      if(current_counter >= @sysvar::Vehicle_input::Message_Counter::Counter_unchange)
      {
        @sysvar::Vehicle_input::Message_Counter::ONEBOX_3_0x22B_RC2 = 0;
        current_counter = 0;
      }
    }
    else
    {
      data[9] = E2E_Counter(data,9);
      MSG_Data[0] = 0x4E;
      MSG_Data[1] = 0x00;
