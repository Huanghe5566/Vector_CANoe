variables
{
  //以下用于控制报文自定义时间丢失的作用，默认为5000ms
  //建议命名方式为message名 + ID 
  msTimer ONEBOX_1_0x98;
  msTimer ACU_2_0x31;
  msTimer ACU_3_0x21;
  msTimer FLZCU_1_0x23B;
  msTimer FLZCU_9_0x49D;
  msTimer FRZCU_1_0x2AB;
  msTimer FLZCU_28_0x4E9;
  msTimer ICC_COM_8_0x510;
