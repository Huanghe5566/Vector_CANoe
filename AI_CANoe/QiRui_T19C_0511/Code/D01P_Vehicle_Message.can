//以下是节点控制报文
on sysvar_update sysvar::Vehicle_input::Node::GCW51
{
  long node;
  if (@this == 1)
  {
    node = ILControlStop();//停止发送该节点报文
  }
  else
  {
    node = ILControlStart();//开始发送该节点报文
  }
}



on sysvar_update sysvar::Vehicle_input::MSG::RRCR_2_0x4F7
{
  if(@this == 1)
  {
    ILFaultInjectionDisableMsg(RRCR_2);
    setTimer(RRCR_2_0x4F7,@sysvar::Vehicle_input::Message_MissingTime::RRCR_2_0x4F7);
  }
  else
  {
    ILFaultInjectionEnableMsg(RRCR_2);
  } 
}


