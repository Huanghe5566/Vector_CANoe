  msTimer TMS_1_0x494;
  msTimer VCU_2_G_0x4B9;
  msTimer VCU_COM_10_0x38;
  msTimer VCU_ONEBOX_11_0x3B;
  msTimer RRCR_2_0x4F7;
  msTimer VCC_1_0x40B;
  msTimer Gettime;
  dword gc_dwCRC16InitValue = 0xFFFF;         
  long tm[9];
  
}


on timer Gettime{
  InitReportAndLog();
}

//在函数内部完成所有操作
void InitReportAndLog()
{
  long tm[9];
  getLocalTime(tm);
  //正确赋值到变量（确保时间在合理范围）
  $CAN1::GCW51::ICC_COM_8::CurrentTimeYear = tm[5]+1900; // 年（如2025）
  $CAN1::GCW51::ICC_COM_8::CurrentTimeMonth = tm[4]+1; // 月（1-12）
  $CAN1::GCW51::ICC_COM_8::CurrentTimeDay = tm[3];    // 日（1-31）
  $CAN1::GCW51::ICC_COM_8::CurrentTimeHour = tm[2];   // 时（0-23）
  $CAN1::GCW51::ICC_COM_8::CurrentTimeMinute = tm[1]; // 分（0-59）
  $CAN1::GCW51::ICC_COM_8::CurrentTimeSecond = tm[0]; // 秒（0-59） 
  setTimer(Gettime,1000);
  //write("%d_%02d_%02d_%02d_%02d_%02d",tm[5]+1900,tm[4]+1,tm[3],tm[2],tm[1],tm[0]);
  
}




on Start
{
  InitReportAndLog();
  //$CAN1::GCW_T1TP::FLZCU_9::FLZCU_9_PowerMode=2;
  $CAN1::GCW51::FLZCU_9::FuelVehPowerMode=2;
  //$CAN1::GCW51::VCU_COM_10::VCU_ActualGearValidData=1;
  $CAN1::GCW51::SAS_1::SAM_1_SteeringAngle=0;
  $CAN1::GCW51::ACU_2::ACU_2_YawRate=0;
  $CAN1::GCW51::TMS_1::ExternalTemperature_C=20;
  
}

